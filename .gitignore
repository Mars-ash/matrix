# ---------------------------------------------------------------------------
# Root .gitignore for Matrix Project Controlling (Frontend + Backend)
# ---------------------------------------------------------------------------

# Operating System Files
.DS_Store
Thumbs.db
*.pem
*.bak

# Environment & Secrets (Root, Frontend, Backend)
.env
.env.*
.env*.local
!.env.example

# Local Docker Overrides
docker-compose.override.yml
!docker-compose.override.yml.example

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Dependencies & Build Artifacts (Global)
node_modules/
*/node_modules/

# Database Dumps & Backups
backups/
*.sql
*.dump

# ---------------------------------------------------------------------------
# Frontend (Next.js & Node)
# ---------------------------------------------------------------------------
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/test-results/

# ---------------------------------------------------------------------------
# Backend (Laravel & PHP)
# ---------------------------------------------------------------------------
backend/vendor/
backend/.phpactor.json
backend/.phpunit.result.cache
backend/.phpunit.cache
backend/auth.json
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/pail/
backend/storage/backups/*
!backend/storage/backups/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/_ide_helper.php
backend/Homestead.json
backend/Homestead.yaml

# Local Test Reports & Context Snapshots
.context/
scripts/testing/*-results.json
.vite/
results.json
docs/
AGENTS/
How to/

# IDE & Tooling
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
repomix*
